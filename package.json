	"private": true,
	"scripts": {
		"build": "next build",
		"check": "next lint && tsc --noEmit",
		"db:generate": "prisma generate --schema=./services/prisma/schema.prisma",
		"db:migrate": "prisma migrate deploy --schema=./services/prisma/schema.prisma",
		"db:migrate:dev": "prisma migrate dev --schema=./services/prisma/schema.prisma",
		"db:push": "prisma db push --schema=./services/prisma/schema.prisma",
		"db:studio": "prisma studio --schema=./services/prisma/schema.prisma",
		"db:seed": "tsx services/prisma/seed/index.ts",
		"dev": "next dev --turbo",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
		"format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
		"lint": "next lint",
		"lint:fix": "next lint --fix",
		"preview": "next build && next start",
		"start": "next start",
		"typecheck": "tsc --noEmit"
	},
